# ARBITER_ENV=DEV (default) uses Unix sockets for local development
# ARBITER_ENV=PROD connects via vsock to AWS Nitro Enclave
ARBITER_ENV=DEV

ALPACA_API_KEY_ID=your_alpaca_key_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_here
ARBITER_COMPLIANCE_TOKEN=your_compliance_token_here

# Redis URL for live market data feed (optional — runs with empty order book if unavailable)
ARBITER_REDIS_URL=redis://127.0.0.1:6379

# Only needed when ARBITER_ENV=PROD
# ARBITER_ENCLAVE_CID=16
