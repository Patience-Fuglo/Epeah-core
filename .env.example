# EPEAH_ENV=DEV (default) uses Unix sockets for local development
# EPEAH_ENV=PROD connects via vsock to AWS Nitro Enclave
EPEAH_ENV=DEV

ALPACA_API_KEY_ID=your_alpaca_key_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_here
EPEAH_COMPLIANCE_TOKEN=your_compliance_token_here

# Redis URL for live market data feed (optional — runs with empty order book if unavailable)
EPEAH_REDIS_URL=redis://127.0.0.1:6379

# Only needed when EPEAH_ENV=PROD
# EPEAH_ENCLAVE_CID=16
